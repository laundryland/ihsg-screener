name: Update Saham Data

on:
  schedule:
    # Berjalan setiap 30 menit (Hari Senin - Jumat)
    - cron: '*/30 2-9 * * 1-5'
  workflow_dispatch: # Memungkinkan update manual dari halaman GitHub Actions

jobs:
  update-data:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.x'

      - name: Install Dependencies
        run: |
          python -m pip install --upgrade pip
          pip install yfinance

      - name: Run Fetch Script
        run: python fetch_data.py

      - name: Commit & Push Update
        run: |
          git config --global user.name 'github-actions[bot]'
          git config --global user.email 'github-actions[bot]@users.noreply.github.com'
          git add data.json
          git diff --quiet && git diff --staged --quiet || (git commit -m "Auto update data saham" && git push)
